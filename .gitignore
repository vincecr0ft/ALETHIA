.env
.DS_Store
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
*.egg-info/
.arize-tmp-traces/

# Vendored LHAPDF build (rebuild with `make lhapdf`)
vendor/

.adk/
agent/**/.adk/

# Local outputs from surrogate demos.
scripts/surrogate_demos/output/

# Claude Code local harness config (personal; not for sharing).
.claude/

# MadGraph oracle's per-process disk cache.
**/processes/*/.alethia_cache/

# Experiment run outputs — regenerated by the scripts; keep them out of the
# upload. A small curated subset of summary.json is already tracked and stays.
experiments/**/output/
experiments/**/output_*/
experiments/**/*.npz
experiments/**/*.log

# LaTeX build artifacts (rebuild with the paper Makefile / latexmk).
paper/*.aux
paper/*.log
paper/*.blg
paper/*.out
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
texput.log
