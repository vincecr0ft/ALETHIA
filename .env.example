# ALETHIA — environment configuration. Copy to .env and fill in.
# The local-Docker path below needs only a Gemini key.

# --- Gemini auth (pick one path) ---
# Simplest: a Google AI Studio API key.
GOOGLE_API_KEY=
# Or Vertex AI (uncomment these, and comment out GOOGLE_API_KEY above):
# GOOGLE_GENAI_USE_VERTEXAI=1
# GOOGLE_CLOUD_PROJECT=<your-project>
# GOOGLE_CLOUD_LOCATION=us-central1

# Model override (optional)
# GEMINI_MODEL=gemini-2.5-flash

# --- Phoenix tracing ---
# Default: local self-hosted Phoenix from docker-compose (`make phoenix-up`).
# No API key needed; the agent points at http://localhost:6006.
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=alethia

# To use Phoenix Cloud (recommended for Cloud Run): set the OTLP collector
# endpoint to your space hostname (Phoenix -> Settings; it includes /s/<space>)
# and a px_live_... key:
# PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/your-space
# PHOENIX_API_KEY=px_live_...

# Set PHOENIX_TRACING=0 to disable tracing entirely.
# PHOENIX_TRACING=1

# --- Phoenix MCP (agent-level partner integration; enabled in Cloud Run) ---
# When ALETHIA_PHOENIX_MCP=1 the agent launches the Arize Phoenix MCP server
# (npx @arizeai/phoenix-mcp) so it can read its own traces/experiments.
# Off by default for local dev (needs Node). The deploy image sets it to 1.
# ALETHIA_PHOENIX_MCP=1
# MCP baseUrl is the bare Phoenix host (NOT the /s/<space> collector URL).
# For Phoenix Cloud this is https://app.phoenix.arize.com ; defaults to the
# collector endpoint if unset.
# PHOENIX_MCP_BASE_URL=https://app.phoenix.arize.com

# --- Cloud Run deploy (used by ./deploy.sh) ---
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id   # or pass PROJECT_ID=... to deploy.sh
# REGION=us-central1
# SERVICE=alethia-agent
