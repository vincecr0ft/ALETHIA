\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces  Closed-form-head prediction at four context sizes through the closed-loop run on the withheld $|c_{\ell q}^{(3)}| \in [0.6, 1.0]$ band, target $\bm  {c}_\star = (0, 0, 0.8, 0)$. All four panels use identical $\bm  {\psi }_\theta $ weights; only the context grows. Top-left: thin seed context of $K = 8$ observations in $m_{\ell \ell }\in [0.5, 1.0]$~TeV; the extrapolation flatlines at $\mu \approx 60$ with RMSE $264.91$ on the $50$-point target grid. Top-right: after the first EPIG fire ($K = 13$) the closed-form ridge solve tracks the truth (black) to RMSE $2.43$, a factor of $\sim \!100$ recovery from the five oracle calls inside the drifted region. Bottom row: cycles $10$ and $100$ at $K = 28$ and $K = 178$. Blue dots are the context observations available to the model at each snapshot. The vertical axis is logarithmic in all four panels, which makes the seed flatline (top-left) visible against the steeply rising truth.}}{12}{figure.caption.8}\protected@file@percent }
\newlabel{fig:snapshots}{{3}{12}{Closed-form-head prediction at four context sizes through the closed-loop run on the withheld $|c_{\ell q}^{(3)}| \in [0.6, 1.0]$ band, target $\bm {c}_\star = (0, 0, 0.8, 0)$. All four panels use identical $\psib _\theta $ weights; only the context grows. Top-left: thin seed context of $K = 8$ observations in $\mll \in [0.5, 1.0]$~TeV; the extrapolation flatlines at $\mu \approx 60$ with RMSE $264.91$ on the $50$-point target grid. Top-right: after the first EPIG fire ($K = 13$) the closed-form ridge solve tracks the truth (black) to RMSE $2.43$, a factor of $\sim \!100$ recovery from the five oracle calls inside the drifted region. Bottom row: cycles $10$ and $100$ at $K = 28$ and $K = 178$. Blue dots are the context observations available to the model at each snapshot. The vertical axis is logarithmic in all four panels, which makes the seed flatline (top-left) visible against the steeply rising truth}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces  Trajectories of the four monitoring quantities through the $400$-cycle closed-loop run on the analytic SMEFT oracle. Top left: target-set predictive entropy $H_T$ from equation~(\ref {eq:ht}), monotone-decreasing as expected from the leverage monotonicity. Top right: design-matrix condition number $\kappa (\bm  {A})$, climbing from $10^3$ to $3 \times 10^5$ as the context fills previously unsampled directions of $\bm  {\psi }_\theta (M)$. Bottom left: per-region empirical $68\%$ coverage (five $m_{\ell \ell }$-regions overlaid) relative to the nominal target (dashed line). Bottom right: cumulative oracle calls and context size against cycle, both linear-rising until budget exhaustion at cycle $\sim 300$.}}{13}{figure.caption.9}\protected@file@percent }
\newlabel{fig:trajectory}{{4}{13}{Trajectories of the four monitoring quantities through the $400$-cycle closed-loop run on the analytic SMEFT oracle. Top left: target-set predictive entropy $H_T$ from equation~(\ref {eq:ht}), monotone-decreasing as expected from the leverage monotonicity. Top right: design-matrix condition number $\kappa (\bm {A})$, climbing from $10^3$ to $3 \times 10^5$ as the context fills previously unsampled directions of $\psib _\theta (M)$. Bottom left: per-region empirical $68\%$ coverage (five $\mll $-regions overlaid) relative to the nominal target (dashed line). Bottom right: cumulative oracle calls and context size against cycle, both linear-rising until budget exhaustion at cycle $\sim 300$}{figure.caption.9}{}}
